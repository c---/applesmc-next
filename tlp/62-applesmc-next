#!/bin/sh
# 62-applesmc-next - TLP battery plugin for Intel Macs using applesmc-next
#
# Stop-threshold-only plugin for the applesmc-next out-of-tree driver, which
# exposes the SMC "BCLM" key as charge_control_end_threshold on the SBS
# battery. The firmware has no start threshold: the driver's
# charge_control_start_threshold is a read-only dummy that always reads 0,
# so this plugin never writes it and START_CHARGE_THRESH_BAT0 is ignored.
#
# Structure follows TLP 1.10's 60-macbook plugin
# (Copyright (c) 2026 Thomas Koch <linrunner at gmx.net> and others).
# SPDX-License-Identifier: GPL-2.0-or-later

# Needs: tlp-func-base, 35-tlp-func-batt, tlp-func-stat

readonly BATDRV_APPLESMC_NEXT_DEV=/sys/devices/platform/applesmc.768

batdrv_init () {
    # rc: 0=matching hardware detected/1=not detected/2=no batteries detected
    _batdrv_plugin="applesmc"
    _batdrv_kmod="applesmc"

    if [ -n "$X_BAT_PLUGIN_SIMULATE" ]; then
        [ "$X_BAT_PLUGIN_SIMULATE" = "$_batdrv_plugin" ] || return 1
    elif wordinlist "$_batdrv_plugin" "$X_BAT_PLUGIN_DENYLIST"; then
        return 1
    elif [ ! -d "$BATDRV_APPLESMC_NEXT_DEV" ]; then
        echo_debug "bat" "batdrv_init.${_batdrv_plugin}.no_match"
        return 1
    fi

    _natacpi=254
    _bm_read="natacpi"
    _bm_thresh="none"
    _bm_dischg="none"
    _bn_start=""
    _bn_stop=""
    _bn_dischg=""
    _batteries=""
    _bt_def_start=0
    _bt_def_stop=100

    local bd
    for bd in "$ACPIBATDIR"/BAT[01]; do
        [ "$(read_sysf "$bd/present")" = "1" ] || continue
        _batteries="${_batteries}${_batteries:+ }${bd##/*/}"
        [ -n "$_bn_stop" ] && continue
        if [ "$NATACPI_ENABLE" = "0" ]; then
            _natacpi=32
        elif readable_sysf "$bd/charge_control_end_threshold"; then
            # end threshold provided by applesmc-next via the sbs hook
            _natacpi=0
            _bm_thresh="natacpi"
            _bn_stop="charge_control_end_threshold"
        fi
    done

    # without the applesmc-next attribute the stock drivers are in use:
    # step aside so the generic plugin reports the battery honestly
    if [ -z "$_batteries" ]; then
        return 2
    elif [ "$_bm_thresh" != "natacpi" ] && [ -z "$X_BAT_PLUGIN_SIMULATE" ]; then
        echo_debug "bat" "batdrv_init.${_batdrv_plugin}.no_end_threshold"
        return 1
    fi

    _batdrv_selected=$_batdrv_plugin
    echo_debug "bat" "batdrv_init.${_batdrv_plugin}: batteries=$_batteries; natacpi=$_natacpi; thresh=$_bm_thresh; bn_stop=$_bn_stop"
    return 0
}

batdrv_select_battery () {
    # $1: BAT0/BAT1/DEF
    _bat_str=""
    _bt_cfg_bat=""
    _bd_read=""
    _bf_start=""
    _bf_stop=""
    _bf_dischg=""

    case "$1" in
        DEF) _bat_str="${_batteries%% *}" ;;
        *)   wordinlist "$1" "$_batteries" && _bat_str="$1" ;;
    esac
    [ -n "$_bat_str" ] || return 1

    _bt_cfg_bat="$_bat_str"
    _bd_read="$ACPIBATDIR/$_bat_str"
    [ "$_bm_thresh" = "natacpi" ] && _bf_stop="$_bd_read/$_bn_stop"
    return 0
}

batdrv_read_threshold () {
    # $1: start/stop; $2: 0=api/1=tlp-stat output
    # rc: 0=ok/4=read error/255=no api
    local out="" rc=0

    if [ "$1" = "start" ]; then
        # no start threshold in firmware
        [ "$2" = "1" ] && printf "(not supported)"
        return 255
    fi

    if [ "$1" = "stop" ] && [ -n "$X_THRESH_SIMULATE_STOP" ]; then
        printf "%s" "$X_THRESH_SIMULATE_STOP"
        return 0
    fi

    if [ "$_bm_thresh" != "natacpi" ]; then
        [ "$2" = "1" ] && printf "(not available)"
        return 255
    fi
    if ! out=$(read_sysf "$_bf_stop") || [ "$X_THRESH_SIMULATE_READERR" = "1" ]; then
        [ "$2" = "1" ] && printf "(not available)"
        return 4
    fi
    printf "%s" "$out"
    return $rc
}

batdrv_write_thresholds () {
    # $1: start (ignored, no hardware support); $2: stop 10..100/DEF
    # $3: 0=quiet/1=output parameter errors/2=output progress and errors
    # $4: non-empty string indicates thresholds stem from configuration
    # rc: 0=ok/1=not configured/2=out of range/4=read error/5=write error
    local new_stop=${2:-}
    local verb=${3:-0}
    local old_stop rc=0

    [ "$new_stop" = "DEF" ] && new_stop=$_bt_def_stop

    if [ -n "$4" ] && [ -z "$new_stop" ]; then
        return 1
    fi

    if ! is_uint "$new_stop" 3 || [ "$new_stop" -lt 10 ] || [ "$new_stop" -gt 100 ]; then
        case $verb in
            1) echo_message "Error in configuration at STOP_CHARGE_THRESH_${_bt_cfg_bat}=\"${new_stop}\": not specified or invalid (must be 10..100). Battery skipped." ;;
            2) cprintf "" "Error: stop charge threshold (%s) for battery %s is not specified or invalid (must be 10..100). Aborted.\n" "$new_stop" "$_bat_str" 1>&2 ;;
        esac
        return 2
    fi

    if ! old_stop=$(batdrv_read_threshold stop 0); then
        case $verb in
            1) echo_message "Error: could not read current stop charge threshold for battery $_bat_str. Battery skipped." ;;
            2) cprintf "" "Error: could not read current stop charge threshold for battery %s. Aborted.\n" "$_bat_str" 1>&2 ;;
        esac
        return 4
    fi

    [ "$verb" = "2" ] && printf "Setting temporary charge threshold for battery %s:\n" "$_bat_str" 1>&2

    if [ "$old_stop" != "$new_stop" ]; then
        write_sysf "$new_stop" "$_bf_stop" || rc=5
        echo_debug "bat" "batdrv.${_batdrv_plugin}.write_thresholds.stop.write: bat=$_bat_str; old=$old_stop; new=$new_stop; rc=$rc"
        case $verb in
            2) if [ $rc -eq 0 ]; then
                   printf "  %-5s = %3d\n" "stop" "$new_stop" 1>&2
               else
                   cprintf "err" "  %-5s = %3d (Error: write failed)\n" "stop" "$new_stop" 1>&2
               fi ;;
            1) [ $rc -gt 0 ] && echo_message "Error: writing stop charge threshold for battery $_bat_str failed." ;;
        esac
    elif [ "$verb" = "2" ]; then
        printf "  %-5s = %3d (no change)\n" "stop" "$new_stop" 1>&2
    fi
    if [ -n "$1" ] && [ "$1" != "DEF" ] && [ "$verb" = "2" ]; then
        printf "  %-5s = (ignored, not supported by firmware)\n" "start" 1>&2
    fi

    [ "$rc" -eq 0 ] && [ "$verb" = "2" ] && soc_gt_stop_notice
    return $rc
}

batdrv_calc_soc () {
    soc_calc "$1"
}

batdrv_chargeonce () {
    return 255
}

batdrv_apply_configured_thresholds () {
    # apply STOP_CHARGE_THRESH_BATx only; output parameter errors only
    local bat stop
    for bat in $_batteries; do
        batdrv_select_battery "$bat" || continue
        eval stop="\$STOP_CHARGE_THRESH_${_bt_cfg_bat}"
        batdrv_write_thresholds "" "$stop" 1 1
    done
    return 0
}

batdrv_read_force_discharge () {
    [ "$1" = "1" ] && printf "(not available)"
    return 255
}

batdrv_write_force_discharge () {
    return 255
}

batdrv_cancel_force_discharge () {
    return 255
}

batdrv_force_discharge_active () {
    return 255
}

batdrv_discharge_safetylock () {
    return 1
}

batdrv_discharge () {
    # Important: release lock from caller
    unlock_tlp tlp_discharge
    return 255
}

batdrv_show_battery_data () {
    local verbose="${1:-0}"
    local bat bcnt=0

    printf "+++ Battery Care\n"
    printf "Plugin: %s\n" "$_batdrv_plugin"
    if [ "$_bm_thresh" != "none" ]; then
        cprintf "success" "Supported features: charge threshold (stop only)\n"
    else
        cprintf "warning" "Supported features: none available\n"
    fi
    printf "Driver usage:\n"
    case $_natacpi in
        0)   printf "* natacpi (%s) = active (stop charge threshold)\n" "$_batdrv_kmod" ;;
        32)  printf "* natacpi (%s) = inactive (disabled by configuration)\n" "$_batdrv_kmod" ;;
        *)   printf "* natacpi (%s) = inactive (applesmc-next not loaded)\n" "$_batdrv_kmod" ;;
    esac
    if [ "$_bm_thresh" != "none" ]; then
        printf "Parameter value ranges:\n"
        printf "* START_CHARGE_THRESH_BAT0:  ignored (not supported by firmware)\n"
        printf "* STOP_CHARGE_THRESH_BAT0:   10..100(default)\n"
    fi
    printf "\n"

    for bat in $_batteries; do
        batdrv_select_battery "$bat"
        printf "+++ Battery Status: %s\n" "$bat"
        print_bat_make "$verbose"
        print_bat_cycle_count "$_bd_read/cycle_count"
        print_bat_energy "$verbose"
        print_bat_state "$_bd_read/status"
        printf "\n"
        print_bat_voltages "$verbose"
        if [ "$_bm_thresh" = "natacpi" ]; then
            printf "%-69s = %6s [%%]\n" "$_bf_stop" "$(batdrv_read_threshold stop 1)"
            printf "\n"
        fi
        print_bat_level
        bcnt=$((bcnt+1))
    done
    [ $bcnt -gt 1 ] && print_bat_level_total
    return 0
}

batdrv_check_soc_gt_stop () {
    local soc stop
    if [ "$_bm_thresh" = "natacpi" ] && soc="$(batdrv_calc_soc)"; then
        stop="$(batdrv_read_threshold stop 0)"
        if [ -n "$stop" ] && [ "$soc" -gt "$stop" ]; then
            return 0
        fi
    fi
    return 1
}

batdrv_recommendations () {
    soc_gt_stop_recommendation
    return 0
}
